{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Anthropic": {
    "Model": "claude-opus-5-5",
    "Effort": "medium"
  },
  "Images": {
    "Root": "card-images"
  },
  "Auth": {
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 60,
    "PasswordResetUrl": "cardscout://reset-password",
    "PasswordResetMinutes": 30,
    "Ebay": { "Environment": "production" },
    "Oidc": { "DisplayName": "SSO", "Scopes": "openid email profile" }
  }
}
