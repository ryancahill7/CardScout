<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CardScout</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="app-header">
        <div class="container-fluid px-4 d-flex align-items-center gap-4">
            <span class="app-header-title">🃏 CardScout</span>
            <nav class="nav">
                <a class="nav-link app-nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Deals" ? "active" : "")" href="/Deals">Deals</a>
                <a class="nav-link app-nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/RecentListings" ? "active" : "")" href="/RecentListings">Recent Listings</a>
            </nav>
        </div>
    </header>

    <main class="container-fluid px-4 py-3">
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>